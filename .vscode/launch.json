  "version": "0.2.0",
  "configurations": [
    {
      "name": "Hugo: Serve (port 1337)",
      "type": "node-terminal",
      "request": "launch",
      "command": "hugo server --port 1337 --baseURL http://localhost:1337/ --appendPort=false --buildDrafts --disableFastRender",
